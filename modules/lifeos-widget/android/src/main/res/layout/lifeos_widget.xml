<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/lifeos_widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/lifeos_widget_background">
 <TextView android:id="@+id/lifeos_widget_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LIFEOS" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12" android:textColor="#D0EE88" android:maxLines="1" android:ellipsize="end"/>
 <TextView android:id="@+id/lifeos_widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Make room for your day." android:textColor="#F3F3F0" android:textSize="19sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/>
 <TextView android:id="@+id/lifeos_widget_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="7dp" android:text="Open LifeOS to prepare your plan." android:textColor="#B2B6BA" android:textSize="13sp" android:lineSpacingExtra="3dp" android:maxLines="6" android:ellipsize="end"/>
 <TextView android:id="@+id/lifeos_widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Tap to open your day" android:textColor="#7E8489" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
